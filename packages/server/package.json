{
  "name": "@u-agents/server",
  "version": "0.9.2",
  "private": true,
  "description": "Standalone headless U Agents server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "craft-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "U Studio",
    "email": "support@u-studio.cn"
  },
  "license": "Apache-2.0",
  "homepage": "https://u-agents.u-studio.cn",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@u-agents/core": "workspace:*",
    "@u-agents/messaging-gateway": "workspace:*",
    "@u-agents/server-core": "workspace:*",
    "@u-agents/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
